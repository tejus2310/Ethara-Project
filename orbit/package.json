{
  "name": "orbit",
  "version": "1.0.0",
  "description": "Orbit - Mission Control for Teams",
  "scripts": {
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && node server.js",
    "dev": "concurrently \"cd backend && npm start\" \"cd frontend && npm run dev\"",
    "seed": "cd backend && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
